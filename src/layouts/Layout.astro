---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Astro on Amplify</title>
	</head>
	<body>
		<nav>
			<a href="/">Home</a>
			<a href="/hello?name=Amplify">Hello</a>
			<a href="/api/time">API: /api/time</a>
		</nav>
		<main>
			<slot />
		</main>
		<footer>Rendered on the server at {new Date().toISOString()}</footer>
	</body>
</html>

<style is:global>
	body {
		font-family: system-ui, sans-serif;
		max-width: 42rem;
		margin: 0 auto;
		padding: 1.5rem 1rem;
		line-height: 1.6;
	}
	nav {
		display: flex;
		gap: 1rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid #ddd;
	}
	footer {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid #ddd;
		font-size: 0.85rem;
		color: #666;
	}
</style>
